{
  "name": "adelphesdiscordbot",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "npx ts-node src/index.ts",
    "start:prod": "npx tsc && pm2 del adelphes-bot && pm2 start dist/index.js --name adelphes-bot",
    "deployCommands": "npx ts-node src/deployCommands.ts",
    "update": "git fetch --all && git reset --hard origin/dev && npm i",
    "updateDeploy": "npm run update && npm run deployCommands && npm run start:prod"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
